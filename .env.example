# ---------------------------------------------------------------------------
# placment_search_term_Automation report -> itrend.search_term_placement_data
#
#   copy .env.example .env      (Linux: cp .env.example .env && chmod 600 .env)
#
# .env holds secrets: never commit it. Exported environment variables take
# precedence over values in this file.
# ---------------------------------------------------------------------------

# --- MySQL (destination is fixed: itrend.search_term_placement_data) --------
DB_HOST=13.232.152.100
DB_PORT=3306
# Must be itrend; any other value is refused.
DB_NAME=itrend
# A login with SELECT, INSERT, UPDATE on itrend.search_term_placement_data, plus
# CREATE once for the first run (see sql/grant_access.sql).
DB_USER=itrend_user
DB_PASSWORD=
# DB_SSL_CA=certs/ca.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_DISABLED=false
DB_CONNECT_TIMEOUT_SECONDS=30
# Rows per INSERT statement.
DB_INSERT_CHUNK_SIZE=2000
# How rows are written, matched on row_key (date | marketplace | campaign |
# ad group | target | advertised product | search term | placement), which is UNIQUE:
#   upsert - insert new rows, update rows already in the table (default)
#   insert - insert new rows only; rows already in the table stay unchanged
# Either way a row is never stored twice and nothing is deleted.
DB_LOAD_MODE=upsert
# Commit every this many rows, so a big file survives a dropped connection and
# a re-run continues where it stopped. 0 = the whole file in one transaction.
DB_COMMIT_EVERY_ROWS=50000
# true: the first run creates the table from the report's columns (and saves
# the SQL it used in sql/create_search_term_placement_data.sql).
DB_AUTO_CREATE_TABLE=true

# --- Dates -------------------------------------------------------------------
# The browser's timezone, and the calendar "today" is judged in (US account).
AMAZON_ACCOUNT_TIMEZONE=America/Los_Angeles
# Your own timezone; only used to show local time in the logs.
REPORT_TIMEZONE=Asia/Kolkata
# Refuse files with rows older than this many days (95 allows any report period
# Amazon offers; upsert makes reloading old days harmless).
MAX_REPORT_AGE_DAYS=95
# Rows dated before this day (YYYY-MM-DD) are not loaded, e.g. when the table
# already holds earlier days from another source. Blank = load every date.
LOAD_FROM_DATE=

# --- Report ------------------------------------------------------------------
# The saved report in Amazon Ads > Reporting:
# https://advertising.amazon.com/reporting/history?entityId=ENTITY1YST5GXMAIR36&reportId=79745ecf-57c1-48de-a3f7-51c1feab3658
REPORT_ID_TODAY=79745ecf-57c1-48de-a3f7-51c1feab3658
AMAZON_ENTITY_ID=ENTITY1YST5GXMAIR36
# Optional: text the report page must show, to catch a swapped ID.
# REPORT_NAME_TODAY=placment_search_term_Automation
# Optional: a second saved copy of the report with period "Yesterday", fetched in
# the first YESTERDAY_FINALIZE_HOURS hours of the Los Angeles day to complete
# the day that just ended.
# REPORT_ID_YESTERDAY=00000000-0000-0000-0000-000000000002
YESTERDAY_FINALIZE_HOURS=2
# true = download the newest finished run ("Download latest") instead of
# clicking Run and waiting. Same as --latest.
DOWNLOAD_LATEST=false
# Optional override; {report_id} and {entity_id} are filled in.
# REPORT_HISTORY_URL_TEMPLATE=https://advertising.amazon.com/reporting/history?entityId={entity_id}&reportId={report_id}

# --- Amazon sign-in ----------------------------------------------------------
# The saved browser session (SESSION_DIR, made by `python run.py --login`) is
# the primary mechanism. These are only used when it has expired.
# CAPTCHA/OTP/MFA always stop the run for a person. Set both or neither.
# AMAZON_EMAIL=
# AMAZON_PASSWORD=
AMAZON_AUTO_LOGIN=true

# --- Files -------------------------------------------------------------------
# Leave unset to auto-detect; set when Amazon's Date column uses another format.
# CSV_DATE_FORMAT=%b %d, %Y
REPORTS_DIR=data/reports
DOWNLOAD_DIR=data/downloads
ARCHIVE_DIR=data/archive
FAILED_DIR=data/failed
SCREENSHOT_DIR=data/screenshots
LOG_DIR=logs
# Chromium profile with the Amazon session. Treat it as a credential.
# Its own session: never share another job's data/session folder.
SESSION_DIR=data/session
LOCK_FILE=data/placement_search_term.lock

# --- Browser and waiting -----------------------------------------------------
HEADLESS=true
# Keep the browser's identity identical for --login and the scheduled runs,
# or Amazon asks for two-step verification again (this Windows PC, Chromium 156):
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36
BROWSER_TIMEOUT_MS=60000
DOWNLOAD_TIMEOUT_MS=300000
# How long a report run may stay at '-' before the attempt is abandoned, and
# how often the history page is reloaded meanwhile.
REPORT_READY_TIMEOUT_SECONDS=900
REPORT_POLL_INTERVAL_SECONDS=30
BROWSER_NO_SANDBOX=false

# --- Retry -------------------------------------------------------------------
# Transient failures only. Authentication is never retried. Keep
# MAX_RETRIES x REPORT_READY_TIMEOUT_SECONDS under an hour.
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=10
RETRY_BACKOFF_MAX_SECONDS=120

# --- Logging and housekeeping --------------------------------------------------
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
# Age at which the app deletes its OWN downloads, archives and screenshots.
FILE_RETENTION_DAYS=3
